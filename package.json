{
  "name": "flightlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sonar": "bun test --coverage --coverage-reporter=lcov && sonar-scanner-npm",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p worker",
    "test": "bun test",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "db:import": "bun scripts/import-flights.ts",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "d3-geo": "^3.1.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-globe.gl": "^2.38.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@sonar/scan": "^5.0.2",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postal-mime": "^4.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.154.0"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
