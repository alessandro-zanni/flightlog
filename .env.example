# Copy to .env.local and fill in. `bunx supabase status -o env` prints the local Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Reads the imported flight mails.
ANTHROPIC_API_KEY=

# Bearer token the Cloudflare Email Worker sends to /api/inbound.
INBOUND_SECRET=

# Gate and terminal of imminent flights (RapidAPI, free plan). Without it the app simply skips the lookup.
AERODATABOX_API_KEY=
